# Address of the API. The default value is used when this variable is not set.
# Copy this file to ".env" (same folder) only if the server does not run on http://localhost:8080.
VITE_API_URL=http://localhost:8080/api

# Set to true to use a fake API that runs in the browser (no server needed), like the GitHub Pages preview.
# VITE_DEMO_MODE=true
